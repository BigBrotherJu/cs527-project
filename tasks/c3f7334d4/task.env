# Task c3f7334d4: coalesced W loads in the MoE BGMV expand kernel
# Reference: flashinfer-ai/flashinfer#3542. The image holds its parent (REF_COMMIT^).
REF_COMMIT=c3f7334d43072684c25456659551446f8a75120b

# CI image named by the parent's ci/docker-tags.yml
# (flashinfer/flashinfer-ci-cu129:20260822-9a0e83b, linux/amd64 digest).
BASE_IMAGE=docker.io/flashinfer/flashinfer-ci-cu129@sha256:b0181ed5707140c87a06834ca07676f20e1c212c2c63e58712a8cf6dfdf312c6

# Architectures the tests cover: _SUPPORTED_SM of the upstream
# tests/moe/test_bgmv_moe.py (the hidden test uses the same set). The kernel also
# compiles for e.g. SM120, but every bgmv test skips there.
SUPPORTED_SM="90 100 103"

# Every upstream test that reaches the expand kernel (also listed in TASK.md).
# The trtllm-gen MoE LoRA test skips below SM100.
VISIBLE_TESTS="tests/moe/test_bgmv_moe.py tests/moe/test_bgmv_moe_lora_delta.py tests/moe/test_trtllm_gen_fused_moe.py::test_moe_lora_delta"

# Where evaluation copies eval/test_hidden_*.py, beside the visible tests so
# they run under the same conftest.py.
HIDDEN_TEST_DIR="tests/moe"

# Compiles the JIT modules and downloads cubins at image build (agents and
# evaluation run offline).
WARMUP_CMD="pytest -q ${VISIBLE_TESTS} && python /task/bench_task.py"
